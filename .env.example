# Public site URL (used for metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://www.yourmarquename.com

# Public contact / social values can also be edited directly in lib/siteConfig.ts
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# ---------------------------------------------------------------------------
# Reserved for future Supabase / database integration.
# NEVER prefix service-role or secret keys with NEXT_PUBLIC_.
# These are read only on the server (API routes / server actions).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for future booking/contact notification integrations
RESEND_API_KEY=
BOOKING_NOTIFICATION_EMAIL=
